 void TerminalInputParser::Timeout(int time) {
+  // noteapp: a paste may arrive across many reads; ESC[201~ ends it, or no
+  // input for paste_timeout_ (a lost end mark must not swallow keys forever).
+  if (in_paste_) {
+    const auto now = std::chrono::steady_clock::now();
+    if (paste_input_) {
+      paste_input_ = false;
+      paste_quiet_since_ = now;
+    } else if (paste_timeout_.count() > 0 &&
+               now - paste_quiet_since_ >= paste_timeout_) {
+      // What came is handed over; bytes that come late are the rest of
+      // the same paste (text, never keys) until ESC[201~ or one more
+      // silent timeout.
+      const bool drained = paste_draining_;
+      EndPaste();
+      if (!drained) {
+        StartPaste(true);
+      }
+    }
+    return;
+  }
   timeout_ += time;
   const int timeout_threshold = 50;
   if (timeout_ < timeout_threshold) {
     return;
   }
   timeout_ = 0;
+  after_cr_ = false;
   if (!pending_.empty()) {
     Send(SPECIAL);
   }
 }
 
 void TerminalInputParser::Add(char c) {
+  if (in_paste_) {
+    AddPasted(c);
+    return;
+  }
+  // noteapp: CR LF in one burst is one line break (a paste without bracketed
+  // mode, or a terminal in newline mode), not two Return events.
+  const bool after_cr = after_cr_;
+  after_cr_ = c == '\r' && pending_.empty();
+  if (c == '\n' && after_cr) {
+    return;
+  }
   pending_ += c;
   timeout_ = 0;
   position_ = -1;
   Send(Parse());
 }
 
+namespace {
+const std::string kPasteStart = "\x1B[200~";  // NOLINT
+const std::string kPasteEnd = "\x1B[201~";    // NOLINT
+}  // namespace
+
+// noteapp: a draining paste keeps the size verdict of the part before it:
+// the rest of a too large paste is dropped without a second notice.
+void TerminalInputParser::StartPaste(bool draining) {
+  in_paste_ = true;
+  paste_draining_ = draining;
+  paste_discard_ = draining && paste_too_large_;
+  paste_too_large_ = paste_discard_;
+  paste_ = kPasteStart;
+  paste_tail_.clear();
+  paste_input_ = false;
+  paste_quiet_since_ = std::chrono::steady_clock::now();
+}
+
+// noteapp: the pasted bytes go out as one event, untouched (no CR -> LF
+// uniformization, no key parsing): Event::Special("\x1B[200~" + text).
+// Over paste_limit_ the bytes are dropped as they come; only the tail is
+// kept to find the end mark.
+void TerminalInputParser::AddPasted(char c) {
+  paste_input_ = true;
+  paste_tail_ += c;
+  if (paste_tail_.size() > kPasteEnd.size()) {
+    paste_tail_.erase(0, 1);
+  }
+  if (!paste_too_large_) {
+    paste_ += c;
+    const std::size_t marks = kPasteStart.size() + kPasteEnd.size();
+    if (paste_limit_ > 0 && paste_.size() > marks &&
+        paste_.size() - marks > paste_limit_) {
+      paste_too_large_ = true;
+      paste_ = std::string();
+    }
+  }
+  if (paste_tail_ != kPasteEnd) {
+    return;
+  }
+  if (!paste_too_large_) {
+    paste_.resize(paste_.size() - kPasteEnd.size());
+  }
+  EndPaste();
+}
+
+void TerminalInputParser::EndPaste() {
+  in_paste_ = false;
+  paste_draining_ = false;
+  if (paste_too_large_) {
+    if (!paste_discard_) {
+      out_(Event::Special("\x1B[noteapp-paste-too-large"));
+    }
+  } else if (paste_.size() > kPasteStart.size()) {
+    out_(Event::SpecialOwned(std::move(paste_)));
+  }
+  paste_ = std::string();  // a large paste does not keep its buffer
+  paste_tail_.clear();
+}
+
